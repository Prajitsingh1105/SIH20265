# Environment Configuration for DEPOSIT-TRACK

# Server & Environment
NODE_ENV=development
PORT=5000
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000

# Security & Secrets
JWT_SECRET=sih2026_super_secure_jwt_secret_strataxx_ai_fdr_portal_987654321
JWT_REFRESH_SECRET=sih2026_super_secure_jwt_refresh_secret_strataxx_ai_fdr_portal_123456789
FILE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL)
DATABASE_URL=postgresql://deposittrack:deposittrackpass@localhost:5432/deposittrack_db?schema=public
# Docker internal database URL
DOCKER_DATABASE_URL=postgresql://deposittrack:deposittrackpass@postgres:5432/deposittrack_db?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
# Docker internal redis URL
DOCKER_REDIS_HOST=redis

# Object Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=fdr-vault

# SMTP Email (Mailpit)
